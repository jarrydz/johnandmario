---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { withBase, quoteSlug } from '../../utils';

const quotes = (await getCollection('quotes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Quotes with a bespoke experience get a door — the whole card links to it,
// marked by the ↗ badge. The rest are read in place: no link, no page (ADR 0015).
const experienceSlugs = new Set(
  Object.keys(import.meta.glob('../../experiences/*.astro')).map((p) =>
    p.replace(/^.*\//, '').replace(/\.astro$/, ''),
  ),
);
---

<BaseLayout title="Read" description="A reading archive — quotes worth keeping.">
  <main>
    <ul class="quote-grid">
      {
        quotes.map((quote) => {
          const slug = quoteSlug(quote.id);
          const bespoke = experienceSlugs.has(slug);
          return <QuoteCard quote={quote} href={bespoke ? withBase(`/read/${slug}`) : undefined} />;
        })
      }
    </ul>
  </main>
</BaseLayout>
