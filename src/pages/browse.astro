---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import RemoteImage from '../components/RemoteImage.astro';
import { withBase } from '../utils';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Build year → months map (sorted descending)
const yearMonths = new Map<number, Set<number>>();
const tagCounts = new Map<string, number>();

for (const post of posts) {
  const d = post.data.date;
  const y = d.getFullYear();
  const m = d.getMonth();
  if (!yearMonths.has(y)) yearMonths.set(y, new Set());
  yearMonths.get(y)!.add(m);
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const years = [...yearMonths.keys()].sort((a, b) => b - a);
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

const pagefindUrl = withBase('/pagefind/pagefind.js');
const urlPrefix = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Browse" description="Search the archive, or browse every post as a grid of thumbnails.">
  <h1>Browse</h1>

  <input
    id="q"
    class="search-input"
    type="search"
    placeholder="Search descriptions, alt text, tags…"
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
  />

  <!-- Search results: shown only while the search box has a query. -->
  <div id="search-mode" hidden>
    <p id="noresults" class="search-empty" hidden>No matches.</p>
    <div id="results" class="search-results" aria-live="polite"></div>
  </div>

  <!-- Browse mode: the static grid + filters, shown when the search box is empty. -->
  <div id="browse-mode">
    <p class="post-meta archive-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>

    <div class="archive-filters">
      <div class="filter-group">
        <label class="filter-label" for="filter-year">Year</label>
        <select id="filter-year" class="filter-select">
          <option value="">All years</option>
          {years.map((y) => <option value={y}>{y}</option>)}
        </select>
      </div>

      <div class="filter-group">
        <label class="filter-label" for="filter-month">Month</label>
        <select id="filter-month" class="filter-select" disabled>
          <option value="">All months</option>
        </select>
      </div>

      <div class="filter-group filter-group-tags">
        <span class="filter-label">Tags</span>
        <div class="filter-tags" id="filter-tags">
          {sortedTags.map(([tag, count]) => (
            <button type="button" class="filter-tag" data-tag={tag}>
              {tag}<span class="filter-tag-count">{count}</span>
            </button>
          ))}
        </div>
      </div>

      <button type="button" class="filter-clear" id="filter-clear" hidden>Clear filters</button>
    </div>

    <div class="archive-grid" id="archive-grid">
      {
        posts.map((post) => {
          const d = post.data.date;
          const tags = (post.data.tags ?? []).join(',');
          return (
            <a
              class="thumb"
              href={withBase(`/posts/${post.id}`)}
              title={post.data.title ?? post.data.image_alt ?? ''}
              data-year={d.getFullYear()}
              data-month={d.getMonth()}
              data-tags={tags}
            >
              {post.data.r2_key ? (
                <RemoteImage
                  src={post.data.r2_key}
                  alt={post.data.image_alt ?? ''}
                  width={post.data.image_width}
                  height={post.data.image_height}
                  widths={[320, 640]}
                  sizes="(max-width: 600px) 33vw, 180px"
                  loading="lazy"
                />
              ) : post.data.image ? (
                <Image src={post.data.image} alt={post.data.image_alt ?? ''} width={320} loading="lazy" />
              ) : (
                <span class="thumb-text">{post.data.title ?? post.data.post_type}</span>
              )}
            </a>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .search-input {
    width: 100%;
    font-family: inherit;
    font-size: 1.05rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    background: var(--color-bg);
    color: var(--color-text);
    margin: 0.5rem 0 1.25rem;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--color-muted);
  }
</style>

<!-- Archive (browse) filtering -->
<script define:vars={{ yearMonthsJSON: Object.fromEntries([...yearMonths.entries()].map(([y, ms]) => [y, [...ms].sort((a, b) => a - b)])), MONTH_NAMES }}>
  const yearSelect = document.getElementById('filter-year');
  const monthSelect = document.getElementById('filter-month');
  const clearBtn = document.getElementById('filter-clear');
  const tagButtons = document.querySelectorAll('.filter-tag');
  const grid = document.getElementById('archive-grid');
  const thumbs = grid.querySelectorAll('.thumb');
  const countEl = document.querySelector('.archive-count');

  let activeTag = null;

  function applyFilters() {
    const year = yearSelect.value;
    const month = monthSelect.value;
    let visible = 0;

    for (const el of thumbs) {
      const matchYear = !year || el.dataset.year === year;
      const matchMonth = !month || el.dataset.month === month;
      const matchTag = !activeTag || el.dataset.tags.split(',').includes(activeTag);
      const show = matchYear && matchMonth && matchTag;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    }

    countEl.textContent = `${visible} ${visible === 1 ? 'post' : 'posts'}`;
    clearBtn.hidden = !year && !month && !activeTag;
  }

  yearSelect.addEventListener('change', () => {
    const y = yearSelect.value;
    monthSelect.innerHTML = '<option value="">All months</option>';
    if (y && yearMonthsJSON[y]) {
      for (const m of yearMonthsJSON[y]) {
        const opt = document.createElement('option');
        opt.value = m;
        opt.textContent = MONTH_NAMES[m];
        monthSelect.appendChild(opt);
      }
      monthSelect.disabled = false;
    } else {
      monthSelect.disabled = true;
    }
    applyFilters();
  });

  monthSelect.addEventListener('change', applyFilters);

  for (const btn of tagButtons) {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag;
      if (activeTag === tag) {
        activeTag = null;
        btn.classList.remove('active');
      } else {
        document.querySelector('.filter-tag.active')?.classList.remove('active');
        activeTag = tag;
        btn.classList.add('active');
      }
      applyFilters();
    });
  }

  clearBtn.addEventListener('click', () => {
    yearSelect.value = '';
    monthSelect.innerHTML = '<option value="">All months</option>';
    monthSelect.disabled = true;
    activeTag = null;
    document.querySelector('.filter-tag.active')?.classList.remove('active');
    applyFilters();
  });
</script>

<!-- Pagefind full-text search -->
<script is:inline define:vars={{ pagefindUrl, urlPrefix }}>
  const q = document.getElementById('q');
  const browseMode = document.getElementById('browse-mode');
  const searchMode = document.getElementById('search-mode');
  const resultsEl = document.getElementById('results');
  const noresultsEl = document.getElementById('noresults');

  let pagefind = null;
  let debounceTimer = null;

  function escapeAttr(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }

  function showBrowse() {
    searchMode.hidden = true;
    browseMode.hidden = false;
    resultsEl.innerHTML = '';
  }

  async function runSearch() {
    const term = q.value.trim();

    if (!term) {
      showBrowse();
      return;
    }

    browseMode.hidden = true;
    searchMode.hidden = false;

    if (!pagefind) {
      noresultsEl.hidden = false;
      noresultsEl.textContent = 'Search index not available — run `npm run build` first.';
      return;
    }

    const res = await pagefind.search(term);
    const first = res.results.slice(0, 30);
    const loaded = await Promise.all(first.map((r) => r.data()));

    if (loaded.length === 0) {
      resultsEl.innerHTML = '';
      noresultsEl.textContent = 'No matches.';
      noresultsEl.hidden = false;
      return;
    }
    noresultsEl.hidden = true;

    resultsEl.innerHTML = loaded.map((d) => {
      const raw = d.url || '';
      const url = urlPrefix && raw.startsWith('/') && !raw.startsWith(urlPrefix + '/')
        ? urlPrefix + raw
        : raw;
      const img = d.meta && d.meta.image ? d.meta.image : '';
      const date = d.meta && d.meta.date ? d.meta.date : '';
      const tagList = (d.filters && d.filters.tag) ? d.filters.tag : [];
      const tags = tagList.map((t, i) =>
        `${i > 0 ? '<span class="tag-sep">·</span>' : ''}<span class="tag">${escapeAttr(t)}</span>`
      ).join('');
      return `<a class="search-result" href="${escapeAttr(url)}">
        <div class="thumb">${img ? `<img src="${escapeAttr(img)}" alt="" loading="lazy">` : ''}</div>
        <div>
          <p class="meta">${escapeAttr(date)}</p>
          <p class="excerpt">${d.excerpt}</p>
          ${tags ? `<span class="tags">${tags}</span>` : ''}
        </div>
      </a>`;
    }).join('');
  }

  function debouncedSearch() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(runSearch, 150);
  }

  q.addEventListener('input', debouncedSearch);

  (async () => {
    pagefind = await import(pagefindUrl);
    await pagefind.options({ excerptLength: 30 });
    // If the box already has a value (e.g. browser restored it), search now.
    if (q.value.trim()) runSearch();
  })().catch((err) => {
    console.error(err);
  });
</script>
