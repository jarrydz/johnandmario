---
import type { CollectionEntry } from 'astro:content';
import ExperienceFrame from '../layouts/ExperienceFrame.astro';

/**
 * "We must all suffer from one of two pains…" — Jim Rohn
 *
 * A dark terminal. The quote types itself across the middle of the screen in
 * a small monospace face, one character at a time, behind a blinking DOS-style
 * block cursor. Discipline is keystrokes — small, steady, one at a time.
 *
 * Legibility floor (ADR 0015): the full quote is server-rendered as real DOM
 * text. The inline script clears and retypes it only when JS runs AND the
 * visitor allows motion — so no-JS and reduced-motion visitors see the
 * finished text, which is also this page's reduced-motion still.
 */

interface Props {
  quote: CollectionEntry<'quotes'>;
}

const { quote } = Astro.props;
const { attribution } = quote.data;
const body = (quote.body ?? '').replace(/\s+/g, ' ').trim();
---

<ExperienceFrame quote={quote} backdrop="#1a1a1a">
  <main class="crt">
    <blockquote class="terminal">
      <p class="line"><span class="typed">{body}</span></p>
      {
        attribution && (
          <footer class="line attribution">
            <span class="typed">— <cite>{attribution}</cite></span>
          </footer>
        )
      }
      <span class="cursor" aria-hidden="true"></span>
    </blockquote>
  </main>

  <script is:inline>
    // Parser-blocking on purpose: clears the text before first paint so there
    // is no flash of the full quote ahead of the typing run.
    (() => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const terminal = document.querySelector('.terminal');
      const cursor = terminal.querySelector('.cursor');
      const spans = [...terminal.querySelectorAll('.typed')];
      const lines = spans.map((span) => ({ span, text: span.textContent }));

      // Terminal cursor discipline: solid while keys are landing, blinking
      // only once the typist is idle for a beat.
      let solidTimer;
      const keystroke = () => {
        cursor.classList.add('solid');
        clearTimeout(solidTimer);
        solidTimer = setTimeout(() => cursor.classList.remove('solid'), 220);
      };

      // ------------------------------------------------------ the auto-typist
      // Human keystroke rhythm: uneven letter intervals, quick spaces, a real
      // stop after punctuation, and the occasional mid-word hesitation.
      const jitter = (min, max) => min + Math.random() * (max - min);
      const delay = (ch) => {
        let d;
        if ('.:'.includes(ch)) d = jitter(450, 750);
        else if (',;—'.includes(ch)) d = jitter(240, 420);
        else if (ch === ' ') d = jitter(55, 120);
        else d = jitter(50, 130);
        if (Math.random() < 0.07) d += jitter(150, 400);
        return d;
      };

      let li = 0;
      let ci = 0;
      let interrupted = false;
      const start = () => setTimeout(tick, 600); // let the screen settle first
      const tick = () => {
        if (interrupted) return; // the visitor has the keyboard now
        const line = lines[li];
        if (!line) return; // done — cursor settles into its idle blink
        if (ci === 0) line.span.after(cursor);
        if (ci < line.text.length) {
          const ch = line.text[ci++];
          line.span.textContent += ch;
          keystroke();
          setTimeout(tick, delay(ch));
        } else {
          li++;
          ci = 0;
          setTimeout(tick, 900); // idle beat before the attribution line
        }
      };

      if (reducedMotion) {
        // No animation: full text stands, cursor rests at the end.
        interrupted = true;
        const last = lines[lines.length - 1];
        if (last) last.span.after(cursor);
      } else {
        lines.forEach(({ span }) => (span.textContent = ''));
        if (lines[0]) lines[0].span.after(cursor);
        // Background tabs throttle timers to a crawl — hold the first
        // keystroke until the page is actually being looked at, so the typing
        // always plays from the top.
        if (document.hidden) {
          document.addEventListener('visibilitychange', function onVisible() {
            if (document.hidden) return;
            document.removeEventListener('visibilitychange', onVisible);
            start();
          });
        } else {
          start();
        }
      }

      // ------------------------------------------------------- the visitor
      // The terminal is live: type anywhere, any time, and the quote is yours
      // to extend or erase. A keypress mid-animation takes the keyboard from
      // the auto-typist wherever it got to.
      const currentSpan = () => {
        // The cursor always sits directly after the span it's typing into.
        const prev = cursor.previousElementSibling;
        return prev && prev.classList.contains('typed') ? prev : null;
      };
      const appendChar = (span, ch) => span.append(ch);
      const deleteChar = (node) => {
        // Trim one character off the end, descending through markup (the
        // attribution holds a <cite>). Returns false once the node is empty.
        while (node.lastChild) {
          const last = node.lastChild;
          if (last.nodeType === Node.TEXT_NODE) {
            if (last.data.length > 0) {
              last.data = last.data.slice(0, -1);
              if (last.data.length === 0) node.removeChild(last);
              return true;
            }
            node.removeChild(last);
          } else if (last.nodeType === Node.ELEMENT_NODE) {
            if (deleteChar(last)) return true;
            node.removeChild(last);
          } else {
            node.removeChild(last);
          }
        }
        return false;
      };

      window.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.isComposing) return;
        const printable = e.key.length === 1;
        if (!printable && e.key !== 'Backspace' && e.key !== 'Enter') return;
        e.preventDefault();
        interrupted = true;

        const span = currentSpan();
        if (!span) return;
        if (printable) {
          appendChar(span, e.key);
        } else if (e.key === 'Enter') {
          appendChar(span, '\n');
        } else {
          // Backspace: eat backwards, hopping up a line when this one is dry.
          if (!deleteChar(span)) {
            const idx = lines.findIndex((l) => l.span === span);
            if (idx > 0) {
              lines[idx - 1].span.after(cursor);
              deleteChar(lines[idx - 1].span);
            }
          }
        }
        keystroke();
      });
    })();
  </script>
</ExperienceFrame>

<style>
  /* Paint the body too, so overscroll and resize never flash the site's light
     background around the terminal. */
  /* Same dark canvas as the rest of the site (--color-bg), hardcoded so the
     terminal stays dark even if the site theme is toggled light. The body
     backdrop matches via the frame's backdrop prop. */
  .crt {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    background: #1a1a1a;
    padding: 2rem 1.25rem;
  }
  .terminal {
    margin: 0;
    width: min(100%, 52ch);
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 2.4vw, 0.95rem);
    line-height: 1.9;
    letter-spacing: 0.02em;
    color: #d6d6d0;
    text-align: left;
  }
  .terminal ::selection {
    background: #d6d6d0;
    color: #1a1a1a;
  }
  .line {
    margin: 0;
    display: inline;
    /* The terminal is editable — Enter types a real newline. */
    white-space: pre-wrap;
  }
  .attribution {
    display: block;
    margin-top: 1.9em;
    opacity: 0.65;
  }
  .attribution cite {
    font-style: normal;
  }
  /* DOS block cursor: sits flush after the last typed character, blinking in
     hard steps — no fade. Under prefers-reduced-motion the frame freezes the
     animation, leaving a steady block at the end of the finished text. */
  .cursor {
    display: inline-block;
    width: 0.62em;
    height: 1.15em;
    margin-left: 0.12em;
    vertical-align: text-bottom;
    background: currentColor;
    animation: blink 1.06s steps(1) infinite;
  }
  /* While keystrokes are landing the cursor holds solid — a terminal only
     blinks when the typist is idle. Dropping the class restarts the blink
     from its visible phase, so the cursor never vanishes mid-word. */
  .cursor.solid {
    animation: none;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
