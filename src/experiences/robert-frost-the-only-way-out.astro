---
import type { CollectionEntry } from 'astro:content';
import ExperienceFrame from '../layouts/ExperienceFrame.astro';

/**
 * "The only way out is through." — Robert Frost
 *
 * A daily maze, played the way maze.toys plays its mini daily: one 15×15
 * perfect maze for the local day, a trail that grows as you walk and shrinks
 * when you step back, a sun waiting at the far corner, a reset, and a
 * streak that survives until you miss a day. No print. Built for a phone —
 * the maze fits the screen, and the pad under it is thumb-sized.
 *
 * Light mode is the site's beige (#ede4dd). Dark mode is this page's own
 * night version: beige ink on the site's near-black, same accent orange
 * trail. The switch is the site's theme, so Read stays in step.
 *
 * Legibility floor (ADR 0015): the quote and attribution are real, selectable
 * text in the masthead, present with or without JavaScript. Movement is
 * user-driven, not an animation, so the maze stays playable under
 * prefers-reduced-motion. The only decorative motion — the victory panel
 * arriving — lives in the no-preference block.
 */

interface Props {
  quote: CollectionEntry<'quotes'>;
}

const { quote } = Astro.props;
const { attribution } = quote.data;
const body = (quote.body ?? '').replace(/\s+/g, ' ').trim();
---

<ExperienceFrame quote={quote} backdrop="#1a1a1a">
  <main class="play" data-maze data-mode="dark">
    <script is:inline>
      // Before first paint: follow the site theme so dark (the default) and
      // beige don't flash the wrong ground.
      (function () {
        var root = document.currentScript.parentElement;
        var light = document.documentElement.getAttribute('data-theme') === 'light';
        root.dataset.mode = light ? 'light' : 'dark';
        document.body.style.background = light ? '#ede4dd' : '#1a1a1a';
      })();
    </script>
    <header class="mast">
      <blockquote>
        <p>{body}</p>
        {attribution && (
          <footer>
            <cite>{attribution}</cite>
          </footer>
        )}
      </blockquote>
      <div class="tools">
        <p class="hint">Reach the sun. New maze tomorrow.</p>
        <button type="button" class="mode" data-mode-toggle>Light</button>
      </div>
    </header>

    <section class="panel" aria-label="Daily streak">
      <p class="row">
        <span>Solved today</span>
        <span class="mark" data-today aria-live="polite">✘</span>
      </p>
      <p class="row row--split">
        <span>Streak <b data-streak>0</b></span>
        <span>Longest <b data-longest>0</b></span>
      </p>
      <p class="row row--action">
        <button type="button" data-reset>reset</button>
      </p>
    </section>

    <div class="board" data-board>
      <canvas data-canvas aria-label="Daily maze. Start at the top left. The sun is the way out."></canvas>
      <div class="victory" data-victory hidden>
        <h2>Through.</h2>
        <p>You've got a streak going.</p>
        <p class="victory-stats">
          <span>Time <b data-time>0s</b></span>
          <span>Moves <b data-moves>0</b></span>
        </p>
      </div>
      <noscript>
        <p class="noscript">The maze needs JavaScript. The line still stands.</p>
      </noscript>
    </div>

    <div class="pad" role="group" aria-label="Move">
      <button type="button" class="up" data-dir="up" aria-label="Up">↑</button>
      <button type="button" class="left" data-dir="left" aria-label="Left">←</button>
      <button type="button" class="down" data-dir="down" aria-label="Down">↓</button>
      <button type="button" class="right" data-dir="right" aria-label="Right">→</button>
    </div>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-maze]');
      if (!root) return;

      const SIZE = 15;
      const ACCENT = '#ff5000';
      const STORAGE_KEY = 'johnandmario.maze.daily';
      // North, east, south, west — 1 means the wall is open.
      const DIRS = {
        up: { dx: 0, dy: -1, bit: 0 },
        right: { dx: 1, dy: 0, bit: 1 },
        down: { dx: 0, dy: 1, bit: 2 },
        left: { dx: -1, dy: 0, bit: 3 },
      };

      const canvas = root.querySelector('[data-canvas]');
      const ctx = canvas.getContext('2d');
      const board = root.querySelector('[data-board]');
      const victory = root.querySelector('[data-victory]');
      const todayEl = root.querySelector('[data-today]');
      const streakEl = root.querySelector('[data-streak]');
      const longestEl = root.querySelector('[data-longest]');
      const timeEl = root.querySelector('[data-time]');
      const movesEl = root.querySelector('[data-moves]');

      const today = dayKey(new Date());
      let cells = newMaze(SIZE, SIZE, mulberry32(hashSeed(today)));
      let path = [{ x: 0, y: 0 }];
      let moves = 0;
      let startTime = null;
      let finished = false;
      let cell = 16;

      function dayKey(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
      }

      function shift(iso, delta) {
        const [y, m, d] = iso.split('-').map(Number);
        const date = new Date(y, m - 1, d);
        date.setDate(date.getDate() + delta);
        return dayKey(date);
      }

      function hashSeed(str) {
        let h = 2166136261;
        for (let i = 0; i < str.length; i++) {
          h ^= str.charCodeAt(i);
          h = Math.imul(h, 16777619);
        }
        return h >>> 0;
      }

      function mulberry32(seed) {
        let a = seed >>> 0;
        return function rng() {
          a |= 0;
          a = (a + 0x6d2b79f5) | 0;
          let t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      // Recursive backtracker. Every cell is visited once, so the maze is
      // perfect: exactly one route from the top-left to the sun.
      function newMaze(x, y, rng) {
        const total = x * y;
        const grid = [];
        const unseen = [];
        for (let i = 0; i < y; i++) {
          grid[i] = [];
          unseen[i] = [];
          for (let j = 0; j < x; j++) {
            grid[i][j] = [0, 0, 0, 0];
            unseen[i][j] = true;
          }
        }
        let cy = Math.floor(rng() * y);
        let cx = Math.floor(rng() * x);
        const stack = [[cy, cx]];
        unseen[cy][cx] = false;
        let visited = 1;
        while (visited < total) {
          const options = [
            [cy - 1, cx, 0, 2],
            [cy, cx + 1, 1, 3],
            [cy + 1, cx, 2, 0],
            [cy, cx - 1, 3, 1],
          ].filter((n) => n[0] > -1 && n[0] < y && n[1] > -1 && n[1] < x && unseen[n[0]][n[1]]);
          if (options.length) {
            const next = options[Math.floor(rng() * options.length)];
            grid[cy][cx][next[2]] = 1;
            grid[next[0]][next[1]][next[3]] = 1;
            unseen[next[0]][next[1]] = false;
            visited++;
            cy = next[0];
            cx = next[1];
            stack.push([cy, cx]);
          } else {
            stack.pop();
            const prev = stack[stack.length - 1];
            if (!prev) break;
            cy = prev[0];
            cx = prev[1];
          }
        }
        return grid;
      }

      function loadGames() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          const data = raw ? JSON.parse(raw) : {};
          return Array.isArray(data.games) ? data.games : [];
        } catch (e) {
          return [];
        }
      }

      function streakInfo(games) {
        const days = new Set(games.map((g) => g.hash));
        const completed = days.has(today);
        let cursor = completed ? today : shift(today, -1);
        let streak = 0;
        while (days.has(cursor)) {
          streak++;
          cursor = shift(cursor, -1);
        }
        const sorted = [...days].sort();
        let longest = 0;
        let run = 0;
        let prev = null;
        for (const d of sorted) {
          run = prev && shift(prev, 1) === d ? run + 1 : 1;
          if (run > longest) longest = run;
          prev = d;
        }
        return { completed, streak, longest };
      }

      function paintStreak() {
        const info = streakInfo(loadGames());
        todayEl.textContent = info.completed ? '✔' : '✘';
        todayEl.classList.toggle('is-done', info.completed);
        todayEl.setAttribute('aria-label', info.completed ? 'Solved today' : 'Not solved today');
        streakEl.textContent = String(info.streak);
        longestEl.textContent = String(info.longest);
      }

      function saveWin(time, moveCount) {
        try {
          const games = loadGames();
          const found = games.find((g) => g.hash === today);
          if (found) {
            if (time < found.time) found.time = time;
            if (moveCount < found.moves) found.moves = moveCount;
          } else {
            games.unshift({ hash: today, time, moves: moveCount });
          }
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ games }));
        } catch (e) {
          /* private mode — the run still finishes, the streak just won't keep */
        }
      }

      function formatTime(ms) {
        const seconds = Math.floor(ms / 1000) % 60;
        const minutes = Math.floor(ms / 60000) % 60;
        const hours = Math.floor(ms / 3600000);
        if (hours) return hours + 'h ' + minutes + 'm ' + seconds + 's';
        if (minutes) return minutes + 'm ' + seconds + 's';
        return seconds + 's';
      }

      // Kept in script, not read back from CSS: the canvas paints during
      // parse, before the scoped stylesheet is guaranteed to have applied.
      const THEMES = {
        dark: { cell: '#161412', wall: '#ede4dd' },
        light: { cell: '#ffffff', wall: '#1a1a1a' },
      };
      function palette() {
        return THEMES[root.dataset.mode === 'light' ? 'light' : 'dark'];
      }

      // A small sun: gold disc, eight rays, a dark ring so it still reads
      // once the orange trail arrives underneath it.
      function drawSun(x, y, s) {
        const cx = x + s / 2;
        const cy = y + s / 2;
        const r = s * 0.2;
        ctx.save();
        ctx.beginPath();
        ctx.rect(x + 1, y + 1, s - 2, s - 2);
        ctx.clip();
        ctx.translate(cx, cy);
        ctx.lineCap = 'round';
        ctx.strokeStyle = '#e8a000';
        ctx.lineWidth = Math.max(1.25, s * 0.055);
        const inner = r + s * 0.05;
        const outer = s * 0.4;
        for (let i = 0; i < 8; i++) {
          const a = (Math.PI * 2 * i) / 8 - Math.PI / 2;
          ctx.beginPath();
          ctx.moveTo(Math.cos(a) * inner, Math.sin(a) * inner);
          ctx.lineTo(Math.cos(a) * outer, Math.sin(a) * outer);
          ctx.stroke();
        }
        ctx.fillStyle = '#ffd24a';
        ctx.beginPath();
        ctx.arc(0, 0, r, 0, Math.PI * 2);
        ctx.fill();
        ctx.lineWidth = Math.max(1, s * 0.045);
        ctx.strokeStyle = '#1a1a1a';
        ctx.stroke();
        ctx.fillStyle = '#fff4c2';
        ctx.beginPath();
        ctx.arc(-r * 0.28, -r * 0.3, r * 0.32, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      function draw() {
        const pad = 3;
        const px = pad * 2 + cell * SIZE;
        const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
        canvas.width = Math.round(px * dpr);
        canvas.height = Math.round(px * dpr);
        canvas.style.width = px + 'px';
        canvas.style.height = px + 'px';
        root.style.setProperty('--maze', px + 'px');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const colors = palette();
        ctx.fillStyle = colors.cell;
        ctx.fillRect(0, 0, px, px);

        ctx.fillStyle = ACCENT;
        for (const step of path) {
          ctx.fillRect(pad + step.x * cell, pad + step.y * cell, cell, cell);
        }

        ctx.beginPath();
        ctx.strokeStyle = colors.wall;
        ctx.lineWidth = 2;
        ctx.lineCap = 'square';
        ctx.lineJoin = 'miter';
        for (let y = 0; y < SIZE; y++) {
          for (let x = 0; x < SIZE; x++) {
            const open = cells[y][x];
            const x0 = pad + x * cell;
            const y0 = pad + y * cell;
            const x1 = x0 + cell;
            const y1 = y0 + cell;
            if (open[0] === 0) {
              ctx.moveTo(x0, y0);
              ctx.lineTo(x1, y0);
            }
            if (open[1] === 0) {
              ctx.moveTo(x1, y0);
              ctx.lineTo(x1, y1);
            }
            if (open[2] === 0) {
              ctx.moveTo(x0, y1);
              ctx.lineTo(x1, y1);
            }
            if (open[3] === 0) {
              ctx.moveTo(x0, y0);
              ctx.lineTo(x0, y1);
            }
          }
        }
        ctx.stroke();

        drawSun(pad + (SIZE - 1) * cell, pad + (SIZE - 1) * cell, cell);

        const head = path[path.length - 1];
        canvas.setAttribute(
          'aria-label',
          finished
            ? 'Maze solved. The way out was through.'
            : `Daily maze. Column ${head.x + 1} of ${SIZE}, row ${head.y + 1} of ${SIZE}. The sun is the way out, at the bottom right.`,
        );
      }

      function fit() {
        const rect = board.getBoundingClientRect();
        const avail = Math.floor(Math.min(rect.width, rect.height)) - 4;
        if (avail < SIZE) return;
        const next = Math.max(8, Math.min(34, Math.floor(avail / SIZE)));
        if (next !== cell || canvas.width === 0) {
          cell = next;
          draw();
        }
      }

      function tryMove(dir) {
        if (finished) return;
        const spec = DIRS[dir];
        if (!spec) return;
        const last = path[path.length - 1];
        const open = cells[last.y][last.x];
        if (open[spec.bit] === 0) return;
        const next = { x: last.x + spec.dx, y: last.y + spec.dy };
        if (next.x < 0 || next.y < 0 || next.x >= SIZE || next.y >= SIZE) return;
        const prev = path[path.length - 2];
        if (prev && prev.x === next.x && prev.y === next.y) path.pop();
        else path.push(next);

        if (moves === 0) startTime = performance.now();
        moves++;
        draw();

        if (next.x === SIZE - 1 && next.y === SIZE - 1) win();
      }

      function win() {
        finished = true;
        const elapsed = startTime == null ? 0 : performance.now() - startTime;
        timeEl.textContent = formatTime(elapsed);
        movesEl.textContent = String(moves);
        victory.hidden = false;
        saveWin(elapsed, moves);
        paintStreak();
        draw();
      }

      function reset() {
        finished = false;
        moves = 0;
        startTime = null;
        path = [{ x: 0, y: 0 }];
        victory.hidden = true;
        draw();
      }

      function bindPress(el, fn) {
        let delay;
        let repeat;
        const stop = () => {
          clearTimeout(delay);
          clearInterval(repeat);
          delay = null;
          repeat = null;
        };
        el.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return;
          e.preventDefault();
          try {
            el.setPointerCapture(e.pointerId);
          } catch (err) {
            /* capture is a comfort, not a requirement */
          }
          stop();
          fn();
          delay = setTimeout(() => {
            repeat = setInterval(fn, 110);
          }, 350);
        });
        el.addEventListener('pointerup', stop);
        el.addEventListener('pointercancel', stop);
        el.addEventListener('contextmenu', (e) => e.preventDefault());
        // Keyboard activation (Enter / Space) arrives as a click with no pointer.
        el.addEventListener('click', (e) => {
          if (e.detail === 0) fn();
        });
      }

      root.querySelectorAll('[data-dir]').forEach((button) => {
        bindPress(button, () => tryMove(button.getAttribute('data-dir')));
      });
      root.querySelector('[data-reset]').addEventListener('click', reset);

      const KEYS = {
        ArrowUp: 'up',
        ArrowDown: 'down',
        ArrowLeft: 'left',
        ArrowRight: 'right',
        w: 'up',
        a: 'left',
        s: 'down',
        d: 'right',
        W: 'up',
        A: 'left',
        S: 'down',
        D: 'right',
      };
      window.addEventListener('keydown', (e) => {
        const dir = KEYS[e.key];
        if (!dir) return;
        e.preventDefault();
        if (e.repeat) return;
        tryMove(dir);
      });

      function applyMode(mode) {
        const light = mode === 'light';
        root.dataset.mode = light ? 'light' : 'dark';
        document.body.style.background = light ? '#ede4dd' : '#1a1a1a';
        const toggle = root.querySelector('[data-mode-toggle]');
        if (toggle) {
          toggle.textContent = light ? 'Dark' : 'Light';
          toggle.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
        }
        draw();
      }

      root.querySelector('[data-mode-toggle]').addEventListener('click', () => {
        const next = root.dataset.mode === 'light' ? 'dark' : 'light';
        applyMode(next);
        try {
          localStorage.setItem('theme', next);
          if (next === 'light') document.documentElement.setAttribute('data-theme', 'light');
          else document.documentElement.removeAttribute('data-theme');
        } catch (e) {
          /* the page still flips; it just won't be remembered */
        }
      });

      paintStreak();
      applyMode(root.dataset.mode === 'light' ? 'light' : 'dark');
      const observer = new ResizeObserver(() => fit());
      observer.observe(board);
      fit();
    })();
  </script>
</ExperienceFrame>

<style>
  .play {
    /* Dark is the resting night version. Light swaps in the site beige.
       Fixed to the viewport so the maze fits a phone exactly. Bottom padding
       clears the frame's Back link. */
    --paper: #1a1a1a;
    --ink: #ede4dd;
    --muted: #8f8a83;
    --panel: #141414;
    --cell: #161412;
    --wall: #ede4dd;
    position: fixed;
    inset: 0;
    z-index: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: calc(0.7rem + env(safe-area-inset-top)) calc(0.85rem + env(safe-area-inset-right))
      calc(3.5rem + env(safe-area-inset-bottom)) calc(0.85rem + env(safe-area-inset-left));
    overflow: hidden;
    color: var(--ink);
    background: var(--paper);
  }
  .play[data-mode='light'] {
    --paper: #ede4dd;
    --ink: #1a1a1a;
    --muted: #6f6a63;
    --panel: #fff;
    --cell: #fff;
    --wall: #1a1a1a;
  }

  .mast {
    width: min(100%, 34rem);
  }
  .panel,
  .pad {
    /* Track the maze once it has measured itself, and never collapse
       narrower than the status row can stand. */
    width: min(100%, max(16rem, var(--maze, 20rem)));
  }
  .board {
    width: min(100%, 36rem);
  }

  .mast {
    text-align: center;
  }
  .mast blockquote {
    margin: 0;
  }
  .mast p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 4.5vw, 1.6rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .mast footer {
    margin-top: 0.28rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mast cite {
    font-style: normal;
  }
  .tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.35rem;
  }
  .mast p.hint {
    margin: 0;
    flex: 1;
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.72rem;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
  .mode {
    flex: 0 0 auto;
    margin-left: auto;
    padding: 0.28rem 0.65rem;
    font-size: 0.75rem;
  }

  .panel {
    border: 2px solid var(--ink);
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    padding: 0.38rem 0.75rem;
    border-bottom: 2px solid var(--ink);
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row--split span {
    flex: 1;
  }
  .row--split span + span {
    text-align: right;
    padding-left: 0.75rem;
    border-left: 2px solid var(--ink);
  }
  .row b {
    font-weight: 600;
  }
  .row--action {
    padding: 0.4rem;
  }
  .mark {
    font-size: 1.25rem;
    line-height: 1;
    color: #ff5000;
  }
  .mark.is-done {
    color: #178a45;
  }

  button {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--ink);
    background: var(--panel);
    border: 2px solid var(--ink);
    border-radius: 6px;
    box-shadow: -2px 2px 0 var(--ink);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }
  button:active {
    transform: translate(-2px, 2px);
    box-shadow: none;
  }
  button:focus-visible {
    outline: 2px solid #ff5000;
    outline-offset: 2px;
  }
  [data-reset] {
    width: 100%;
    padding: 0.45rem 0.75rem;
    font-size: 0.95rem;
  }

  .board {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  canvas {
    display: block;
    background: var(--cell);
    touch-action: none;
    max-width: 100%;
    max-height: 100%;
  }
  .noscript {
    position: absolute;
    inset: auto 0.5rem 0.5rem;
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .victory {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(17.5rem, calc(100% - 1.25rem));
    padding: 0.95rem 1rem 0.85rem;
    text-align: center;
    background: var(--panel);
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: -3px 3px 0 var(--ink);
    font-family: var(--font-mono);
  }
  .victory[hidden] {
    display: none !important;
  }
  .victory h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
  }
  .victory p {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
