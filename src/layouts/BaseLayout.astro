---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  /** Portal-style chrome: wordmark only, no nav, no width-constrained container. */
  minimal?: boolean;
}

const { title, description, minimal = false } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header minimal={minimal} />
    {minimal ? <slot /> : <div class="container"><slot /></div>}
  </body>
</html>
